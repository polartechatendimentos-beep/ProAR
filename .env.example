# Vercel Postgres Connection (Auto-populated by Vercel when linking Vercel Postgres)
POSTGRES_URL="postgres://default:xxx@ep-xxx.postgres.vercel-storage.com:5432/verceldb?sslmode=require"
POSTGRES_PRISMA_URL="postgres://default:xxx@ep-xxx.postgres.vercel-storage.com:5432/verceldb?pgbouncer=true&connect_timeout=15&sslmode=require"
POSTGRES_URL_NON_POOLING="postgres://default:xxx@ep-xxx.postgres.vercel-storage.com:5432/verceldb?sslmode=require"
POSTGRES_USER="default"
POSTGRES_HOST="ep-xxx.postgres.vercel-storage.com"
POSTGRES_PASSWORD="xxx"
POSTGRES_DATABASE="verceldb"

# WhatsApp API Configuration
WHATSAPP_API_URL="https://api.whatsapp.com/v1"
WHATSAPP_API_TOKEN="seu_token_whatsapp"
WHATSAPP_PHONE_NUMBER_ID="seu_phone_number_id"

# Security & Cron
CRON_SECRET="seu_secret_para_cron"
NEXTAUTH_SECRET="sua_chave_secreta_auth"
