# Banco mestre do ProAR Manager
SUPABASE_URL=https://SEU-PROJETO-MESTRE.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# Sessões e criptografia de credenciais de tenants
PROAR_SESSION_SECRET=troque-por-um-segredo-forte
PROAR_TENANT_MASTER_KEY=troque-por-uma-chave-mestra-forte-e-separada
PROAR_MANAGER_SESSION_SECRET=troque-por-um-segredo-forte-e-exclusivo
PROAR_MANAGER_USER=admin-do-manager
PROAR_MANAGER_PASSWORD=troque-por-uma-senha-longa-e-exclusiva

# Provisionamento automático de um Supabase exclusivo por empresa
# Management API oficial do Supabase. Sem estas duas variáveis o Manager marca o tenant como "manual".
SUPABASE_MANAGEMENT_TOKEN=sbp_...
SUPABASE_ORGANIZATION_SLUG=sua-organizacao

# Opcional: se definido, usa senha fixa no trial (não recomendado em produção).
# Se vazio, o ProAR gera uma senha temporária forte e obriga troca futura.
PROAR_TRIAL_DEFAULT_PASSWORD=

# Usuários internos fora de tenants (hash gerado por scrypt; nunca colocar senhas em texto puro)
PROAR_USERS_JSON=[{"username":"admin.tavs","displayName":"Administrador TAV's","passwordHash":"scrypt$SALT_HEX$HASH_HEX","role":"Administrador","permissions":["*"],"active":true}]

# Proteção do cadastro público de trial
PROAR_TRIAL_RATE_SECRET=troque-por-um-segredo-exclusivo-para-rate-limit
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Domínio raiz usado para resolução automática de tenants por subdomínio.
PROAR_ROOT_DOMAIN=proar.app
