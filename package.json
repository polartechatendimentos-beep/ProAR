{
  "name": "proar-gestao-servicos",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/prepare-document-assets.mjs && next dev",
    "build": "node scripts/prepare-document-assets.mjs && NODE_ENV=production next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "validate:fast": "npm run typecheck && npm run lint && npm test",
    "validate": "npm run validate:fast && npm run build",
    "check": "npm run validate",
    "test": "node --experimental-strip-types --experimental-specifier-resolution=node tests/run.mjs",
    "lint": "eslint app components lib",
    "db:generate": "drizzle-kit generate",
    "test:contracts": "node --experimental-strip-types tests/module-contracts.test.mjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@vercel/blob": "^2.9.0",
    "drizzle-orm": "0.45.2",
    "jspdf": "4.2.1",
    "lucide-react": "^0.468.0",
    "next": "16.4.6",
    "node-forge": "^1.3.1",
    "pdfjs-dist": "6.4.299",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "tesseract.js": "7.0.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.6",
    "react-server-dom-webpack": "19.2.9",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.3.8",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "displayName": "ProAR — Gestão de Serviços",
  "overrides": {
    "@vercel/cli-config": {
      "zod": "^4.6.7"
    }
  }
}
